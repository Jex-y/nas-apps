# Copy to $APP_DIR/.env on the host and fill in. The deploy script links it into every release.

# The stack's address on the tailnet: `apps` (the sidecar's hostname) plus your tailnet's DNS name.
PUBLIC_HOST=apps.<tailnet>.ts.net

# One-off Tailscale auth key: not reusable, not ephemeral, pre-approved, tagged tag:apps. Only read on first start.
TS_AUTHKEY=

POSTGRES_USER=apps
POSTGRES_PASSWORD=

# `openssl rand -hex 32` for the secrets, and `GK` followed by `openssl rand -hex 12` for the access key.
# Garage creates the key and the `apps` bucket on first start.
GARAGE_RPC_SECRET=
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=

# Web Push, from `bunx web-push generate-vapid-keys`. Changing the pair invalidates every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Flats times commutes with it; see the README.
TFL_API_KEY=

# Optional. Flats reads and ranks listings with Jev; see the README.
TYPESAFE_API_KEY=
